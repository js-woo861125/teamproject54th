<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ks54team01.customer.contract.mapper.CustomerContractMapper">
	
	
	<resultMap type="CustomerContract" id="contractResultMap">
		
		<id 	column="rental_contract_no" 		property="rentalContractNo" />
		<result column="ent_ceo_no" 				property="entCeoNo" />
		<result column="ent_emp_id" 				property="entEmpId" />
		<result column="sell_products_no" 			property="sellProdNo" />
		<result column="cust_id" 					property="custId" />
		<result column="rental_contract_status" 	property="rentalContractStatus" />
		<result column="contract_quantity" 			property="contractQuantity" />
		<result column="contract_period" 			property="contractPeriod" />		
		<result column="rental_start_date" 			property="rentalStartDate" />
		<result column="rental_end_date" 			property="rentalEndDate" />
		<result column="rental_cancel_date" 		property="rentalCancelDate" />
		<result column="contract_date" 				property="contractDate" />
		
	</resultMap>
	
	
	
	<insert id="addCustomerContract" parameterType="CustomerContract">
		INSERT INTO rental_contract
			(rental_contract_no, ent_ceo_no, ent_emp_id, sell_products_no, cust_id, rental_contract_status, contract_quantity, contract_period, 
			 rental_start_date, rental_end_date, rental_cancel_date, contract_date)
		VALUES
			(#{rentalContractNo}, #{entCeoNo}, #{entEmpId}, #{sellProdNo}, #{custId}, '계약완료', #{contractQuantity}, #{contractPeriod},
			 NULL, NULL, NULL, CURDATE())
	</insert>
	
</mapper>







