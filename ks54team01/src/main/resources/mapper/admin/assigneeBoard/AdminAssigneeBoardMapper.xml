<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  <mapper namespace="ks54team01.admin.assigneeBoard.mapper.AdminAssigneeBoardMapper">
  
  	<delete id="removeAssigneeBoard" parameterType="string">
		/* 양수 게시글 삭제하기 */
		DELETE
		FROM
			assignee_board
		WHERE
			assignee_no = #{assigneeBoardNum};
	</delete>
  	
  </mapper>